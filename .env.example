# Copy to .env (never commit it) and fill in what you use. Empty values are
# ignored, so Phemius uses the saved setting or the default instead.
# Every variable is described under "Configuration" in README.md.

# The container always runs in network mode (PHEMIUS_ACCESS_MODE=network, set in
# docker-compose.yml): it listens on all interfaces and requires this token.
# Access token for the web UI and API, at least 16 characters. Generate one with
# `openssl rand -hex 32`. Leave it empty and Phemius creates one on the first
# start and prints it once: `docker compose logs phemius | grep token`.
PHEMIUS_ACCESS_TOKEN=

# Script model: offline, openrouter, openai, openai_compatible or ollama.
# Empty means openrouter when OPENROUTER_API_KEY is set, otherwise offline.
PHEMIUS_SCRIPT_PROVIDER=
PHEMIUS_MODEL=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
# An OpenAI-compatible server (openai_compatible). Inside the container,
# localhost is the container itself: use http://host.docker.internal:1234/v1
# for a server on the host.
PHEMIUS_SCRIPT_BASE_URL=
PHEMIUS_SCRIPT_API_KEY=
# Ollama on the host: http://host.docker.internal:11434
PHEMIUS_OLLAMA_URL=
PHEMIUS_OLLAMA_MODEL=

# Voice engine: kokoro (default), openai_speech, elevenlabs or stub.
PHEMIUS_TTS=
PHEMIUS_VOICE=
PHEMIUS_OPENAI_SPEECH_API_KEY=
ELEVENLABS_API_KEY=

# Audio file format: wav (default), m4a, mp4 or mp3.
PHEMIUS_FORMAT=

# Watched folder: uncomment the /watch volume in docker-compose.yml first.
# PHEMIUS_WATCH_DIR=/watch
